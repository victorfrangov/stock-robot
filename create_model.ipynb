    "# PROPER FIX: Safe Return Calculation that respects log_transform_target setting\n",
    "def safe_return_analysis(results, pytorch_data):\n",
    "    \"\"\"Analyze model performance with safe return calculations - RESPECTS ACTUAL CONFIG\"\"\"\n",
    "    \n",
    "    # Get configuration from pytorch_data\n",
    "    log_transform_used = pytorch_data.get('log_transform_target', False)\n",
    "    predicting_returns = pytorch_data.get('predicting_returns', True)\n",
    "    target_scaler_used = pytorch_data['scalers']['target_scaler'] is not None\n",
    "    \n",
    "    # CORRECT INTERPRETATION based on actual configuration\n",
    "    if log_transform_used:\n",
    "        outlier_threshold = 10\n",
    "    else:\n",
    "        outlier_threshold = 50\n",
    "        \n",
    "    print(f\"🔧 Analysis Configuration:\")\n",
    "    print(f\"   Log Transform Used: {log_transform_used}\")\n",
    "    print(f\"   Predicting Returns: {predicting_returns}\")\n",
    "    print(f\"   Target Scaling Used: {target_scaler_used}\")\n",
    "    print(f\"📊 Using outlier threshold: ±{outlier_threshold}%\")\n",
    "    print(\"=\" * 60)\n",
    "    \n",
    "    for name, result in results.items():\n",
    "        print(f\"\\n📊 {name} Model Analysis (CONFIG-AWARE):\")\n",
    "        print(\"-\" * 40)\n",
    "        \n",
    "        # Get the raw data\n",
    "        actuals = np.array(result['actuals'])\n",
    "        predictions = np.array(result['predictions'])\n",
    "        \n",
    "        actual_returns = actuals * 100  # Raw returns as percentages\n",
    "        predicted_returns = predictions * 100\n",
    "        \n",
    "        # Remove extreme outliers based on the data type\n",
    "        mask = (np.abs(actual_returns) < outlier_threshold) & (np.abs(predicted_returns) < outlier_threshold)\n",
    "        \n",
    "        actual_returns_clean = actual_returns[mask]\n",
    "        predicted_returns_clean = predictions[mask]\n",
    "        \n",
    "        if len(actual_returns_clean) == 0:\n",
    "            print(\"⚠️  No valid data after filtering outliers\")\n",
    "            continue\n",
    "        \n",
    "        # Calculate metrics on cleaned data\n",
    "        # Directional accuracy\n",
    "        direction_correct = np.sign(actual_returns_clean) == np.sign(predicted_returns_clean)\n",
    "        directional_accuracy = np.mean(direction_correct) * 100\n",
    "        \n",
    "        # Return prediction R²\n",
    "        returns_r2 = r2_score(actual_returns_clean, predicted_returns_clean)\n",
    "        \n",
    "        # Mean Absolute Error in percentage points\n",
    "        return_mae = np.mean(np.abs(actual_returns_clean - predicted_returns_clean))\n",
    "        \n",
    "        # Display results\n",
    "        transform_type = \"Log Returns\" if log_transform_used else \"Raw Returns\"\n",
    "        print(f\"{transform_type} R²: {returns_r2:.4f}\")\n",
    "        print(f\"Directional Accuracy: {directional_accuracy:.1f}%\")\n",
    "        print(f\"Mean Absolute Error: {return_mae:.2f} percentage points\")\n",
    "        print(f\"Actual Return Volatility: {np.std(actual_returns_clean):.2f}%\")\n",
    "        print(f\"Predicted Return Volatility: {np.std(predicted_returns_clean):.2f}%\")\n",
    "        \n",
    "        # Show ranges\n",
    "        print(f\"Actual returns range: {np.min(actual_returns_clean):.2f}% to {np.max(actual_returns_clean):.2f}%\")\n",
    "        print(f\"Predicted returns range: {np.min(predicted_returns_clean):.2f}% to {np.max(predicted_returns_clean):.2f}%\")\n",
    "        print(f\"Total return spread: {np.max(actual_returns_clean) - np.min(actual_returns_clean):.2f}%\")\n",
    "        \n",
    "        # Price level performance (original metrics)\n",
    "        price_r2 = result['metrics']['r2']\n",
    "        print(f\"Price Level R²: {price_r2:.4f}\")\n",
    "        \n",
    "print(\"🔧 PROPER RETURN ANALYSIS (CONFIG-AWARE)\")\n",
    "print(\"=\" * 60)\n",
    "safe_return_analysis(results, pytorch_data)"
   ]
